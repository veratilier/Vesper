[Unit]
Description=Vesper Codex conversation history API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vesper-codex-history
ExecStart=/usr/bin/python3 /home/ubuntu/vesper-codex-history/codex_history_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
